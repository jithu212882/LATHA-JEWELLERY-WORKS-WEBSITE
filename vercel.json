{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth.js" },
    { "source": "/api/gold-rates/:path*", "destination": "/api/gold-rates.js" },
    { "source": "/api/gold-rates", "destination": "/api/gold-rates.js" },
    { "source": "/api/public/data", "destination": "/api/public.js" },
    { "source": "/api/media/:path*", "destination": "/api/media.js" },
    { "source": "/api/media", "destination": "/api/media.js" },
    { "source": "/api/categories/:path*", "destination": "/api/store.js" },
    { "source": "/api/categories", "destination": "/api/store.js" },
    { "source": "/api/jewellery/:path*", "destination": "/api/store.js" },
    { "source": "/api/jewellery", "destination": "/api/store.js" },
    { "source": "/api/banners/:path*", "destination": "/api/store.js" },
    { "source": "/api/banners", "destination": "/api/store.js" },
    { "source": "/api/content", "destination": "/api/store.js" },
    { "source": "/api/settings", "destination": "/api/store.js" },
    { "source": "/api/enquiries/:path*", "destination": "/api/enquiries.js" },
    { "source": "/api/enquiries", "destination": "/api/enquiries.js" },
    { "source": "/api/reviews/:path*", "destination": "/api/reviews.js" },
    { "source": "/api/reviews", "destination": "/api/reviews.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
